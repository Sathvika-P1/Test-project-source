{
  "color-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1098, 0.098, 0.0902], "hex": "#1c1917"}, "$description": "Default text"},
  "color-fg-muted": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.3412, 0.3255, 0.3059], "hex": "#57534e"}, "$description": "Secondary text and hints"},
  "color-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Page background"},
  "color-bg-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9569], "hex": "#f5f5f4"}, "$description": "Subtle surfaces: secondary buttons, skeletons, hover"},
  "color-border": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9059, 0.898, 0.8941], "hex": "#e7e5e4"}, "$description": "Default borders and dividers"},
  "color-border-strong": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.4706, 0.4431, 0.4235], "hex": "#78716c"}, "$description": "Form control borders"},
  "color-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.7608, 0.2549, 0.0471], "hex": "#c2410c"}, "$description": "Brand and primary actions"},
  "color-primary-hover": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.6039, 0.2039, 0.0706], "hex": "#9a3412"}, "$description": "Primary hover"},
  "color-on-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Text on primary and danger fills"},
  "color-info": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8"}, "$description": "Info accent"},
  "color-info-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8588, 0.9176, 0.9961], "hex": "#dbeafe"}, "$description": "Info tint"},
  "color-success": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0824, 0.502, 0.2392], "hex": "#15803d"}, "$description": "Success accent"},
  "color-success-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8627, 0.9882, 0.9059], "hex": "#dcfce7"}, "$description": "Success tint"},
  "color-warning": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.5216, 0.302, 0.0549], "hex": "#854d0e"}, "$description": "Warning accent"},
  "color-warning-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.9765, 0.7647], "hex": "#fef9c3"}, "$description": "Warning tint"},
  "color-danger": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.7255, 0.1098, 0.1098], "hex": "#b91c1c"}, "$description": "Danger accent and fill"},
  "color-danger-hover": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.6, 0.1059, 0.1059], "hex": "#991b1b"}, "$description": "Danger hover"},
  "color-danger-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.8863, 0.8863], "hex": "#fee2e2"}, "$description": "Danger tint"},
  "color-backdrop": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1098, 0.098, 0.0902], "hex": "#1c1917"}, "$description": "Overlay scrim, used with opacity-backdrop"},

  "space-1": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}, "$description": "Spacing step 1"},
  "space-2": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}, "$description": "Spacing step 2"},
  "space-3": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Spacing step 3"},
  "space-4": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}, "$description": "Spacing step 4"},
  "space-5": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}, "$description": "Spacing step 5"},
  "space-6": {"$type": "dimension", "$value": {"value": 48, "unit": "px"}, "$description": "Spacing step 6"},

  "radius-sm": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}, "$description": "Small corner radius"},
  "radius-md": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}, "$description": "Medium corner radius"},
  "radius-lg": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Large corner radius"},
  "radius-full": {"$type": "dimension", "$value": {"value": 9999, "unit": "px"}, "$description": "Pill / circle"},

  "font-size-xs": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}, "$description": "Captions"},
  "font-size-sm": {"$type": "dimension", "$value": {"value": 14, "unit": "px"}, "$description": "Small text"},
  "font-size-md": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Body text"},
  "font-size-lg": {"$type": "dimension", "$value": {"value": 20, "unit": "px"}, "$description": "Subheadings"},
  "font-size-xl": {"$type": "dimension", "$value": {"value": 30, "unit": "px"}, "$description": "Page headings"},

  "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}, "$description": "Standard border thickness"},
  "size-control-sm": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}, "$description": "Small control height"},
  "size-control-md": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Default control height"},
  "size-control-lg": {"$type": "dimension", "$value": {"value": 48, "unit": "px"}, "$description": "Large control height"},
  "size-avatar": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Avatar diameter"},
  "size-icon": {"$type": "dimension", "$value": {"value": 20, "unit": "px"}, "$description": "Icon and checkbox size"},
  "size-switch-width": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Switch track width"},
  "size-switch-height": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}, "$description": "Switch track height"},
  "size-drawer": {"$type": "dimension", "$value": {"value": 360, "unit": "px"}, "$description": "Drawer width"},
  "size-modal": {"$type": "dimension", "$value": {"value": 480, "unit": "px"}, "$description": "Modal max width"},
  "size-menu": {"$type": "dimension", "$value": {"value": 200, "unit": "px"}, "$description": "Menu minimum width"},
  "size-toast": {"$type": "dimension", "$value": {"value": 320, "unit": "px"}, "$description": "Toast max width"},
  "size-container": {"$type": "dimension", "$value": {"value": 1120, "unit": "px"}, "$description": "Page container max width"},
  "size-grid-min": {"$type": "dimension", "$value": {"value": 220, "unit": "px"}, "$description": "Minimum grid column width"},

  "font-family-sans": {"$type": "fontFamily", "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif", "$description": "Base typeface"},
  "font-weight-regular": {"$type": "fontWeight", "$value": 400, "$description": "Body"},
  "font-weight-medium": {"$type": "fontWeight", "$value": 500, "$description": "Labels and buttons"},
  "font-weight-bold": {"$type": "fontWeight", "$value": 700, "$description": "Headings"},
  "line-height-base": {"$type": "number", "$value": 1.5, "$description": "Body line height"},
  "line-height-tight": {"$type": "number", "$value": 1.25, "$description": "Heading line height"},
  "opacity-backdrop": {"$type": "number", "$value": 0.5, "$description": "Scrim opacity"},
  "opacity-disabled": {"$type": "number", "$value": 0.5, "$description": "Disabled control opacity"},
  "motion-fast": {"$type": "number", "$value": 0.15, "$description": "Transition length in seconds"},
  "motion-spin": {"$type": "number", "$value": 0.8, "$description": "Spinner rotation in seconds"},
  "motion-pulse": {"$type": "number", "$value": 1.5, "$description": "Skeleton pulse in seconds"},
  "z-dropdown": {"$type": "number", "$value": 10, "$description": "Dropdown layer"},
  "z-overlay": {"$type": "number", "$value": 100, "$description": "Drawer and modal layer"},
  "z-toast": {"$type": "number", "$value": 200, "$description": "Toast layer"},

  "button-primary-background": {"$type": "color", "$value": "{color-primary}"},
  "button-primary-foreground": {"$type": "color", "$value": "{color-on-primary}"},
  "button-primary-hover": {"$type": "color", "$value": "{color-primary-hover}"},
  "button-secondary-background": {"$type": "color", "$value": "{color-bg-subtle}"},
  "button-secondary-foreground": {"$type": "color", "$value": "{color-fg}"},
  "button-secondary-border": {"$type": "color", "$value": "{color-border-strong}"},
  "button-ghost-foreground": {"$type": "color", "$value": "{color-primary}"},
  "button-ghost-hover": {"$type": "color", "$value": "{color-bg-subtle}"},
  "button-danger-background": {"$type": "color", "$value": "{color-danger}"},
  "button-danger-foreground": {"$type": "color", "$value": "{color-on-primary}"},
  "button-danger-hover": {"$type": "color", "$value": "{color-danger-hover}"},
  "button-default-radius": {"$type": "dimension", "$value": "{radius-md}"},
  "button-default-padding": {"$type": "dimension", "$value": "{space-3}"},
  "button-default-height": {"$type": "dimension", "$value": "{size-control-md}"},
  "card-default-background": {"$type": "color", "$value": "{color-bg}"},
  "card-default-foreground": {"$type": "color", "$value": "{color-fg}"},
  "card-default-border": {"$type": "color", "$value": "{color-border}"},
  "card-default-radius": {"$type": "dimension", "$value": "{radius-lg}"},
  "card-default-padding": {"$type": "dimension", "$value": "{space-4}"},
  "card-default-gap": {"$type": "dimension", "$value": "{space-3}"}
}
